# getproperty-edge — every variable is optional; meters and buses come only from the cloud config.
GP_STATE_DIR=/var/lib/getproperty-edge
GP_API_URL=https://api.getproperty.co
# Extra CA bundle for the API server (dev/test CAs only)
GP_API_CA_FILE=
# One-time provisioning code (else typed on the status page)
GP_PROVISIONING_CODE=
GP_TZ=Asia/Bangkok
# hardware | simulator
GP_DRIVER_MODE=hardware
# Simulator profile/faults (inline JSON or a file path), see docs/SIMULATOR.md
GP_SIM_CONFIG=
# Override the broker URL from bootstrap (dev only)
GP_MQTT_URL=
GP_MQTT_SERVERNAME=
# HTTPS batch fallback after this many seconds without a broker (0 = off)
GP_HTTPS_FALLBACK_AFTER_S=600
GP_QUEUE_CAPACITY=1000000
GP_STATUS_HOST=0.0.0.0
GP_STATUS_PORT=8080
GP_LOG_LEVEL=info
GP_GPIO_CHIP=gpiochip0
# /sys/class/leds/<name> used by the identify command
GP_LED=
GP_OTA_ROOT=/opt/getproperty-edge
